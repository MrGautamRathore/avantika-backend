# WhatsApp API Configuration (Meta WhatsApp Business Cloud API)
# Get these from your Meta Developer Console (https://developers.facebook.com/)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/avantika-travels

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret

# PayU Payment Gateway (optional)
PAYU_MERCHANT_KEY=your_merchant_key
PAYU_SALT=your_salt

# Server Port
PORT=5000
